---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { url } from "../lib/url";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogAlt?: string;
  home?: boolean;
}

const { title, description, ogImage, ogAlt, home = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imagePath = ogImage ?? url("photos/maternity/maternity-hasitha-03.jpg");
const image = new URL(imagePath, Astro.site);
const preload = home ? url("photos/maternity/maternity-hasitha-03.jpg") : null;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.studio,
  description: site.description,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  image: new URL(url("photos/maternity/maternity-hasitha-03.jpg"), Astro.site).href,
  email: site.email,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lincoln",
    addressRegion: "NE",
    addressCountry: "US",
  },
  areaServed: "Lincoln, Nebraska",
  sameAs: [site.youtube, site.youtubeShortFilms, site.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161310" />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.studio} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Outfit:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header overlay={home} />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
