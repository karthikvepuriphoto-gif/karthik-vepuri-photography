---
import { galleries } from "../data/galleries";
import { site } from "../data/site";
import { url } from "../lib/url";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <p class="footer-name">{site.studio}</p>
      <p>{site.location}</p>
      <div class="footer-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.youtube} rel="noopener noreferrer" target="_blank">YouTube</a>
        <a href={site.facebook} rel="noopener noreferrer" target="_blank">{site.facebookLabel}</a>
      </div>
      <p>© {year} {site.name}</p>
    </div>
    <ul class="footer-nav">
      {
        galleries.map((gallery) => (
          <li>
            <a href={url(`${gallery.slug}/`)}>{gallery.nav}</a>
          </li>
        ))
      }
      <li><a href={url("films/")}>Films</a></li>
      <li><a href={url("short-films/")}>Short Films</a></li>
      <li><a href={url("about/")}>About</a></li>
      <li><a href={url("contact/")}>Contact</a></li>
    </ul>
  </div>
</footer>
