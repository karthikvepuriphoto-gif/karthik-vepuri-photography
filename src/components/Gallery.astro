---
import type { Photo } from "../data/galleries";
import { photoSources } from "../data/galleries";

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="masonry" data-gallery>
  {
    photos.map((photo, index) => {
      const sources = photoSources(photo, base);
      const id = photo.file.split("/").pop()?.replace(/\.jpg$/i, "");
      const lead = index === 0 && photo.width > photo.height;
      return (
        <a
          class:list={["tile", lead && "is-lead"]}
          id={id}
          href={sources.full}
          data-index={index}
        >
          <img
            src={sources.src}
            srcset={sources.srcset}
            sizes="(min-width: 1100px) 32vw, (min-width: 720px) 48vw, 100vw"
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading={index < 2 ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
      );
    })
  }
</div>

<dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
  <div class="lightbox-bar">
    <p class="lightbox-count" data-count></p>
    <button class="lightbox-close" type="button" data-close>Close</button>
  </div>
  <div class="lightbox-stage">
    <button class="lightbox-nav prev" type="button" data-prev aria-label="Previous photograph">‹</button>
    <figure class="lightbox-figure">
      <img data-lightbox-img alt="" />
      <figcaption data-caption></figcaption>
    </figure>
    <button class="lightbox-nav next" type="button" data-next aria-label="Next photograph">›</button>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>
</dialog>

<script>
  const root = document.querySelector<HTMLElement>("[data-gallery]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  if (root && dialog) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>("a.tile")];
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]");
    const caption = dialog.querySelector<HTMLElement>("[data-caption]");
    const count = dialog.querySelector<HTMLElement>("[data-count]");
    const live = dialog.querySelector<HTMLElement>("[data-live]");
    const closeButton = dialog.querySelector<HTMLButtonElement>("[data-close]");
    if (!img || !caption || !count || !live || !closeButton) {
      throw new Error("Lightbox markup missing.");
    }

    let index = 0;
    let trigger: HTMLElement | null = null;

    const show = (nextIndex: number) => {
      index = (nextIndex + links.length) % links.length;
      const link = links[index];
      const thumb = link.querySelector("img");
      const alt = thumb?.alt ?? "";
      img.alt = alt;
      caption.textContent = alt;
      count.textContent = `${index + 1} / ${links.length}`;
      live.textContent = `Photograph ${index + 1} of ${links.length}. ${alt}`;
      const preview = thumb?.currentSrc || thumb?.src;
      if (preview) img.src = preview;
      const full = link.href;
      if (full && full !== img.src) {
        const loader = new Image();
        const token = index;
        loader.onload = () => {
          if (token === index) img.src = full;
        };
        loader.src = full;
      }
    };

    const open = (nextIndex: number, source: HTMLElement) => {
      trigger = source;
      show(nextIndex);
      dialog.showModal();
      closeButton.focus();
    };

    links.forEach((link, linkIndex) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        open(linkIndex, link);
      });
    });

    dialog.querySelector("[data-prev]")?.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-next]")?.addEventListener("click", () => show(index + 1));
    closeButton.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target === dialog || target.classList.contains("lightbox-stage")) dialog.close();
    });

    dialog.addEventListener("close", () => {
      trigger?.focus();
    });

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(index + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === "Home") {
        event.preventDefault();
        show(0);
      } else if (event.key === "End") {
        event.preventDefault();
        show(links.length - 1);
      }
    });
  }
</script>
