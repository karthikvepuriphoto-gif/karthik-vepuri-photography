---
import Base from "../layouts/Base.astro";
import GalleryGrid from "../components/Gallery.astro";
import { galleries, photoSources, type Gallery } from "../data/galleries";
import { site } from "../data/site";
import { url } from "../lib/url";

export function getStaticPaths() {
  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
    props: { gallery },
  }));
}

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
const index = galleries.findIndex((item) => item.slug === gallery.slug);
const prev = galleries[(index - 1 + galleries.length) % galleries.length];
const next = galleries[(index + 1) % galleries.length];
const count = gallery.photos.length;
const og = photoSources(gallery.photos[0], import.meta.env.BASE_URL).full;
---

<Base
  title={`${gallery.title} · ${site.studio}`}
  description={gallery.description}
  ogImage={og}
  ogAlt={gallery.photos[0].alt}
>
  <article class="page">
    <div class="wrap">
      <header class="page-intro">
        <p class="kicker">Gallery</p>
        <h1 class="page-title">{gallery.title}</h1>
        <p class="lede">{gallery.intro}</p>
        <p class="meta-line">{count} photographs</p>
      </header>
      <GalleryGrid photos={gallery.photos} />
      <nav class="pager" aria-label="Other galleries">
        <a href={url(`${prev.slug}/`)}>← {prev.title}</a>
        <a class="next" href={url(`${next.slug}/`)}>{next.title} →</a>
      </nav>
    </div>
  </article>
</Base>
