---
import Base from "../layouts/Base.astro";
import { films, youtubeEmbed } from "../data/films";
import { site } from "../data/site";
import { url } from "../lib/url";

const description =
  "Highlight films by Karthik Vepuri, wedding photographer and filmmaker in Lincoln, Nebraska. Films are being added.";
const ready = films.flatMap((film) => {
  const embed = youtubeEmbed(film.url);
  return embed ? [{ ...film, embed }] : [];
});
---

<Base title={`Highlights & Films · ${site.studio}`} description={description}>
  <article class="page">
    <div class="wrap">
      <header class="page-intro">
        <p class="kicker">Video work</p>
        <h1 class="page-title">Highlights &amp; films</h1>
        <p class="lede">
          Films of these days — ceremonies, families, and gatherings — are on the way.
        </p>
      </header>

      <div class="films-stack">
        {
          ready.length > 0 && (
            <section aria-labelledby="recent-heading">
              <h2 class="embed-label" id="recent-heading">Highlights</h2>
              <div class="shorts">
                {ready.map((film) => (
                  <article class="short">
                    <div class="embed">
                      <iframe
                        src={film.embed}
                        title={film.title}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                      />
                    </div>
                    <h3>{film.title}</h3>
                    <a href={film.url} rel="noopener noreferrer" target="_blank">Watch on YouTube</a>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <section class="film-note" aria-labelledby="book-film">
          <h2 id="book-film" class="page-title">A film for the day.</h2>
          <p>
            Highlight films are part of the work, alongside the still photographs. For a wedding or a celebration, write ahead of the day.
          </p>
          <p>
            <a href={url("contact/")}>Contact</a>
          </p>
        </section>
      </div>
    </div>
  </article>
</Base>
