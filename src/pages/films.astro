---
import Base from "../layouts/Base.astro";
import { films, youtubeEmbed } from "../data/films";
import { site } from "../data/site";
import { url } from "../lib/url";

const description =
  "Wedding highlight films by Karthik Vepuri: Manasa and Rohan, Vikram and Haripriya, Shruti and Reginald, and Alaina and Brandon.";

const ready = films.flatMap((film) => {
  const embed = youtubeEmbed(film.url);
  return embed ? [{ ...film, embed }] : [];
});
const highlights = ready.filter((film) => film.kind === "highlight");
const teasers = ready.filter((film) => film.kind === "teaser");
---

<Base title={`Highlights & Films · ${site.studio}`} description={description}>
  <article class="page">
    <div class="wrap">
      <header class="page-intro">
        <p class="kicker">Video work</p>
        <h1 class="page-title">Highlights &amp; films</h1>
        <p class="lede">
          Wedding films from the same days as the photographs — full highlights first, then a teaser and a short.
        </p>
      </header>

      <div class="films-stack">
        <section aria-labelledby="highlights-heading">
          <h2 class="embed-label" id="highlights-heading">Highlights</h2>
          <div class="film-grid">
            {
              highlights.map((film, index) => (
                <article class:list={["film-card", index === 0 && "is-lead"]}>
                  <div class="embed">
                    <iframe
                      src={film.embed}
                      title={film.title}
                      loading={index === 0 ? "eager" : "lazy"}
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    />
                  </div>
                  <h3>{film.title}</h3>
                  <a href={film.url} rel="noopener noreferrer" target="_blank">Watch on YouTube</a>
                </article>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="teasers-heading">
          <h2 class="embed-label" id="teasers-heading">Teaser &amp; short</h2>
          <div class="teaser-row">
            {
              teasers.map((film) => (
                <article class:list={["film-card", film.portrait && "is-portrait"]}>
                  <div class={film.portrait ? "short-frame" : "embed"}>
                    <iframe
                      src={film.embed}
                      title={film.title}
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    />
                  </div>
                  <h3>{film.title}</h3>
                  <a href={film.url} rel="noopener noreferrer" target="_blank">Watch on YouTube</a>
                </article>
              ))
            }
          </div>
        </section>

        <section class="film-note" aria-labelledby="more-films">
          <h2 id="more-films" class="page-title">More on the channel.</h2>
          <p>
            These are a few of the public films. The rest of the work is on YouTube.
          </p>
          <p>
            <a href={site.youtube} rel="noopener noreferrer" target="_blank">Watch the channel on YouTube</a>
            {" · "}
            <a href={url("contact/")}>Contact</a>
          </p>
        </section>
      </div>
    </div>
  </article>
</Base>
